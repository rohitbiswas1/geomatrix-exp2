# Google Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Google Gemini API Key
GEMINI_API_KEY=

# Optional comma-separated Google account emails permitted to sign in.
# If empty, any Google account with a verified email can sign in.
AUTH_ALLOWED_EMAILS=

# Application Settings
DATABASE_URL=
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.vercel.app
MODEL_API_URL=
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Production deployment
# Vercel: set MODEL_API_URL to Render; browser API calls always use the application origin.
# Set GOOGLE_CLIENT_ID on Render to match NEXT_PUBLIC_GOOGLE_CLIENT_ID on Vercel.
# Render: set FRONTEND_URL to the public Vercel URL and/or provide comma-separated CORS_ORIGINS.
FRONTEND_URL=
CORS_ORIGINS=
